--- /dev/null
+++ b/lib/posix-tty/hl-streams.c
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Opt-in byte streams; kernel diagnostics keep the platform console. */
+#include <limits.h>
+#include <sys/stat.h>
+#include <uk/file.h>
+#include <uk/file/nops.h>
+#include <uk/posix-fd.h>
+#include <uk/posix-serialfile.h>
+#include <hyperlight/hcall.h>
+
+#define CHUNK_BYTES 4096
+static const char STREAM_VOLID[] = "hl_stream";
+
+static ssize_t stream_write(const struct uk_file *f,
+			   const struct iovec *iov, size_t iovcnt,
+			   size_t off, long flags __unused)
+{
+	ssize_t total = 0;
+
+	if (off)
+		return -ESPIPE;
+	for (size_t i = 0; i < iovcnt; i++) {
+		const __u8 *data = iov[i].iov_base;
+		size_t left = iov[i].iov_len;
+
+		if ((!data && left) || left > (size_t)(SSIZE_MAX - total))
+			return total ? total : -EINVAL;
+		while (left) {
+			__u32 count = left < CHUNK_BYTES ? left : CHUNK_BYTES;
+			struct hl_param args[] = {
+				{ .type = HL_PV_HLUINT, .u32_val = (uintptr_t)f->node },
+				{ .type = HL_PV_HLVECBYTES, .vec = { data, count } },
+			};
+			__s32 accepted;
+
+			if (hl_hcall_int("MafWriteBytes", args, 2, &accepted) ||
+			    accepted != (__s32)count)
+				return total ? total : -EIO;
+			data += count;
+			left -= count;
+			total += count;
+		}
+	}
+	return total;
+}
+
+static int stream_getstat(const struct uk_file *f, unsigned int mask,
+			  struct uk_statx *arg)
+{
+	int rc = uk_file_serial.ops->getstat(&uk_file_serial, mask, arg);
+
+	if (!rc)
+		arg->stx_ino = (uintptr_t)f->node;
+	return rc;
+}
+
+static int stream_ctl(const struct uk_file *f __unused, int fam, int req,
+			uintptr_t arg1, uintptr_t arg2, uintptr_t arg3)
+{
+	/* Preserve the driver's terminal detection without console rewriting. */
+	return uk_file_serial.ops->ctl(&uk_file_serial, fam, req, arg1, arg2, arg3);
+}
+
+static const struct uk_file_ops stream_ops = {
+	.read = uk_file_nop_read,
+	.write = stream_write,
+	.mem = uk_file_nop_mem,
+	.getstat = stream_getstat,
+	.setstat = uk_file_nop_setstat,
+	.ctl = stream_ctl,
+};
+
+static uk_file_refcnt out_ref = UK_FILE_REFCNT_INITIALIZER(out_ref);
+static uk_file_refcnt err_ref = UK_FILE_REFCNT_INITIALIZER(err_ref);
+static struct uk_file_state out_state = UK_FILE_STATE_EVENTS_INITIALIZER(
+	out_state, UKFD_POLLOUT);
+static struct uk_file_state err_state = UK_FILE_STATE_EVENTS_INITIALIZER(
+	err_state, UKFD_POLLOUT);
+
+const struct uk_file uk_file_hl_stdout = {
+	.vol = STREAM_VOLID, .node = (void *)1, .ops = &stream_ops,
+	.refcnt = &out_ref, .state = &out_state, ._release = uk_file_static_release
+};
+const struct uk_file uk_file_hl_stderr = {
+	.vol = STREAM_VOLID, .node = (void *)2, .ops = &stream_ops,
+	.refcnt = &err_ref, .state = &err_state, ._release = uk_file_static_release
+};

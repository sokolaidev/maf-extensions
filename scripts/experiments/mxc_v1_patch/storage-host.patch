@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 The Hyperlight Authors.
+
+use std::io;
+
+pub(crate) struct WriteBudget {
+    bytes: u64,
+    files: u64,
+}
+
+impl WriteBudget {
+    pub(crate) fn new(bytes: u64, files: u64) -> Self {
+        Self { bytes, files }
+    }
+
+    // Debit before file creation; failed writes never restore the allowance.
+    pub(crate) fn charge(&mut self, bytes: u64) -> io::Result<()> {
+        if self.files == 0 || bytes > self.bytes {
+            return Err(io::Error::other("snapshot export exceeds reserved bounds"));
+        }
+        self.bytes -= bytes;
+        self.files -= 1;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bytes_are_aggregate_and_exact_boundary_passes() {
+        let mut budget = WriteBudget::new(7, 3);
+        budget.charge(3).unwrap();
+        budget.charge(4).unwrap();
+        assert!(budget.charge(1).is_err());
+        budget.charge(0).unwrap();
+        assert!(budget.charge(0).is_err());
+    }
+
+    #[test]
+    fn refused_charge_cannot_overflow_or_consume_allowance() {
+        let mut budget = WriteBudget::new(3, 1);
+        assert!(budget.charge(u64::MAX).is_err());
+        budget.charge(3).unwrap();
+        assert!(budget.charge(0).is_err());
+    }
+
+    #[test]
+    fn empty_budget_refuses_creation() {
+        assert!(WriteBudget::new(0, 0).charge(0).is_err());
+        assert!(WriteBudget::new(0, 1).charge(1).is_err());
+    }
+}

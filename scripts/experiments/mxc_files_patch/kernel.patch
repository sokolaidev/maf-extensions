 /* One function for stderr and stdout */
 static int dev_stdout_write(struct device *dev __unused, struct uio *uio,
 			    int flags __unused)
 {
+#if CONFIG_LIBPOSIX_TTY_STDOUT_HL_BYTES
+	const struct uk_file *file = !strcmp(dev->name, "stderr") ?
+		&uk_file_hl_stderr : &uk_file_hl_stdout;
+
+	while (uio->uio_resid && uio->uio_iovcnt) {
+		struct iovec *iov = uio->uio_iov;
+		struct iovec part = *iov;
+		ssize_t written;
+
+		if (!iov->iov_len) {
+			uio->uio_iov++;
+			uio->uio_iovcnt--;
+			continue;
+		}
+		if (part.iov_len > uio->uio_resid)
+			part.iov_len = uio->uio_resid;
+		written = file->ops->write(file, &part, 1, 0, 0);
+		if (written <= 0)
+			return written < 0 ? -written : EIO;
+		iov->iov_base = (char *)iov->iov_base + written;
+		iov->iov_len -= written;
+		uio->uio_resid -= written;
+		uio->uio_offset += written;
+	}
+	return 0;
+#else
 	return vfscore_uioforeach(__write_fn, NULL, uio->uio_resid, uio);
+#endif
 }
 

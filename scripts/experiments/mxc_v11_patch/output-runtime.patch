+// SPDX-License-Identifier: Apache-2.0
+//! Preserve truthful output accounting when the omitted-byte counter overflows.
+pub(crate) fn add(total: &mut u64, saturated: &mut bool, bytes: u64) {
+    let (next, overflow) = total.overflowing_add(bytes);
+    *total = if overflow { u64::MAX } else { next };
+    *saturated |= overflow;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::add;
+    #[test]
+    fn exact_boundary_and_overflow_remain_distinct() {
+        let mut total = u64::MAX - 1;
+        let mut saturated = false;
+        add(&mut total, &mut saturated, 1);
+        assert_eq!(total, u64::MAX);
+        assert!(!saturated);
+        add(&mut total, &mut saturated, 1);
+        assert_eq!(total, u64::MAX);
+        assert!(saturated);
+        add(&mut total, &mut saturated, 0);
+        assert_eq!(total, u64::MAX);
+        assert!(saturated);
+    }
+}

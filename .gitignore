__pycache__/
*.pyc
.venv/

# Written into samples/ by tests/test_sample_modules_import.py and deleted in the same call.
# Ignored so a killed run cannot leave one to be committed — pyright does not read .gitignore,
# so the probe is still analysed while it is there.
samples/_pyright_probe_*.py
dist/
.pytest_cache/
.ruff_cache/
.codeql-build/
codeql-results/
bandit-report.json
# MXC generated evidence belongs in Actions artifacts; source pins remain tracked.
/scripts/experiments/mxc*/**/*.json
/scripts/experiments/unikraft_output/**/*.json
!/scripts/experiments/mxc_files_patch/files.json
!/scripts/experiments/mxc_files_patch/kernel.json
!/scripts/experiments/mxc_session_patch/patch.json
!/scripts/experiments/mxc_session_patch/output-patch.json
!/scripts/experiments/mxc_session_patch/storage-patch.json
!/scripts/experiments/mxc_streams_patch/kernel.json
!/scripts/experiments/mxc_streams_patch/streams.json
!/scripts/experiments/mxc_v1_patch/manifest.json
!/scripts/experiments/mxc_v1_patch/rootfs.json
!/scripts/experiments/mxc_v11_patch/manifest.json
!/scripts/experiments/mxc_v11_patch/rootfs.json
*.egg-info/

# Sample runs land artifacts here; the sink is a host directory, not the repository.
samples/*/out/

# Claude Code's per-developer settings, and the git worktrees it creates *inside* the
# repository. Named rather than ignoring `.claude/` whole: a shared `.claude/settings.json`
# belongs in review like any other configuration, and a blanket rule would drop it silently.
# The worktree line is the load-bearing one — a checkout under `.claude/worktrees/` is a
# repository inside this one, and `git add -A` stages it as an embedded submodule.
.claude/settings.local.json
.claude/worktrees/

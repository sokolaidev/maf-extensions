__pycache__/
*.pyc
.venv/

# Written into samples/ by tests/test_sample_modules_import.py and deleted in the same call.
# Ignored so a killed run cannot leave one to be committed — pyright does not read .gitignore,
# so the probe is still analysed while it is there.
samples/_pyright_probe_*.py
dist/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Sample runs land artifacts here; the sink is a host directory, not the repository.
samples/*/out/

# Claude Code's per-developer settings, and the git worktrees it creates *inside* the
# repository. Named rather than ignoring `.claude/` whole: a shared `.claude/settings.json`
# belongs in review like any other configuration, and a blanket rule would drop it silently.
# The worktree line is the load-bearing one — a checkout under `.claude/worktrees/` is a
# repository inside this one, and `git add -A` stages it as an embedded submodule.
.claude/settings.local.json
.claude/worktrees/

 func (p *Proxy) doUpstream(req *http.Request) (*http.Response, error) {
-	return p.transport.RoundTrip(req)
+	if req.URL.Scheme == "http" {
+		if !p.allowPrivateHTTP {
+			return nil, fmt.Errorf("plaintext HTTP is disabled")
+		}
+		req = req.WithContext(context.WithValue(req.Context(), privateHTTPKey{}, true))
+	} else if req.URL.Scheme != "https" {
+		return nil, fmt.Errorf("unsupported upstream scheme %q", req.URL.Scheme)
+	}
+	req, cancel, err := p.credentials.authorize(req)
+	if err != nil {
+		return nil, err
+	}
+	resp, err := p.transport.RoundTrip(req)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	resp.Body = &mafResponseBody{ReadCloser: resp.Body, cancel: cancel}
+	return resp, nil
+}
+
+type privateHTTPKey struct{}
+
+var privatePrefixes = []netip.Prefix{
+	netip.MustParsePrefix("10.0.0.0/8"),
+	netip.MustParsePrefix("172.16.0.0/12"),
+	netip.MustParsePrefix("192.168.0.0/16"),
+	netip.MustParsePrefix("fc00::/7"),
+}
+
+func privateAddress(address string) bool {
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		return false
+	}
+	ip, err := netip.ParseAddr(host)
+	if err != nil {
+		return false
+	}
+	ip = ip.Unmap()
+	for _, prefix := range privatePrefixes {
+		if prefix.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func localAddress(address string) (bool, error) {
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		return false, err
+	}
+	upstream, err := netip.ParseAddr(host)
+	if err != nil {
+		return false, err
+	}
+	interfaces, err := net.InterfaceAddrs()
+	if err != nil {
+		return false, err
+	}
+	for _, addr := range interfaces {
+		assigned, ok := addr.(*net.IPNet)
+		if !ok {
+			continue
+		}
+		if ip, ok := netip.AddrFromSlice(assigned.IP); ok && ip.Unmap() == upstream.Unmap() {
+			return true, nil
+		}
+	}
+	return false, nil
 }
 

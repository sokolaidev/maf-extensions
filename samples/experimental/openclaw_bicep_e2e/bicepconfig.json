{
  "cacheRootDirectory": "/opt/maf-bicep/cache",
  "analyzers": {
    "core": {
      "enabled": true,
      "rules": {
        "no-unused-params": {"level": "error"},
        "use-recent-api-versions": {"level": "warning", "maxAgeInDays": 730},
        "use-recent-module-versions": {"level": "off"}
      }
    }
  }
}

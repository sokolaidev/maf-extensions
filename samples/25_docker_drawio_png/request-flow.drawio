<mxfile>
  <diagram id="request-flow" name="Request flow">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="client" value="Client" vertex="1" parent="1" style="rounded=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=17;">
          <mxGeometry x="20" y="40" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="Orders API" vertex="1" parent="1" style="rounded=1;fillColor=#e0e7ff;strokeColor=#4f46e5;fontSize=17;">
          <mxGeometry x="230" y="40" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="Order store" vertex="1" parent="1" style="rounded=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=17;">
          <mxGeometry x="440" y="40" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="request" edge="1" parent="1" source="client" target="api" style="endArrow=block;endFill=1;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="persist" edge="1" parent="1" source="api" target="db" style="endArrow=block;endFill=1;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

#!/bin/sh
# Runs the pre-push tier of .pre-commit-config.yaml, through `uv`, resolved at run time.
#
# `pre-commit install` bakes the absolute path of the interpreter that installed it into
# .git/hooks/. When that checkout moves or is deleted the hook dies, and it dies badly: the
# generated script falls back to a bare `pre-commit` on PATH, so the error names a missing
# command rather than the stale path that is actually wrong. Nothing here is written at install
# time, and every hook entry in the config already launches through `uv` anyway.
#
# Tracked, so `git config core.hooksPath .githooks` is the whole install. A relative hooksPath
# resolves against each working tree's own root, so a worktree carries its own copy and needs
# no install of its own.
set -e
root=$(git rev-parse --show-toplevel)
exec uv run --project "$root" pre-commit hook-impl \
    --config="$root/.pre-commit-config.yaml" \
    --hook-type=pre-push \
    --hook-dir "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" -- "$@"
